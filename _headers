# Cross-origin isolation for the WebChuGL/WebGPU synth build ONLY.
# ciesen-gl.html needs SharedArrayBuffer (COOP+COEP). The plain ciesen.html
# (audio-only, webchuck/AudioWorklet) does NOT need this — no SAB required.
# No other page may be cross-origin isolated — COEP require-corp would break
# the RNBO CDN script on NEPTR.html and Strudel's runtime sample fetches on
# livecode.html.
/ciesen-gl.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Never let browsers/CDN serve stale site data.
/galaxy.json
  Cache-Control: no-cache

/universe/*
  Cache-Control: no-cache

# The gorcave pages ARE the installed app — there is no separate APK, so a
# stale cached copy is the only way the home-screen app can go out of date.
# no-cache (revalidate before use), NOT no-store: we still want cheap 304s.
# gorcave-version.json is the staleness beacon both pages poll, so it above
# all must never be served from cache.
/gorcave-chat.html
  Cache-Control: no-cache

/gorcave-voice.html
  Cache-Control: no-cache

/gorcave-manifest.json
  Cache-Control: no-cache

/gorcave-version.json
  Cache-Control: no-cache

# Cod Remote is the installed home-screen app for the phone side of the Cod
# desktop agent — same "no separate APK" situation as gorcave above, so the
# same reasoning applies: no-cache (revalidate, allow cheap 304s), and
# remote-version.json (the staleness beacon it polls) must never be cached.
/cod/remote.html
  Cache-Control: no-cache

/cod/remote-manifest.json
  Cache-Control: no-cache

/cod/remote-version.json
  Cache-Control: no-cache
