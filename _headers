# Cross-origin isolation for the WebChuGL synth ONLY.
# ciesen.html needs SharedArrayBuffer (COOP+COEP). No other page may be
# cross-origin isolated — COEP require-corp would break the RNBO CDN
# script on NEPTR.html and Strudel's runtime sample fetches on livecode.html.
/ciesen.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Never let browsers/CDN serve stale site data.
/galaxy.json
  Cache-Control: no-cache

/universe/*
  Cache-Control: no-cache

# The gorcave pages ARE the installed app — there is no separate APK, so a
# stale cached copy is the only way the home-screen app can go out of date.
# no-cache (revalidate before use), NOT no-store: we still want cheap 304s.
# gorcave-version.json is the staleness beacon both pages poll, so it above
# all must never be served from cache.
/gorcave-chat.html
  Cache-Control: no-cache

/gorcave-voice.html
  Cache-Control: no-cache

/gorcave-manifest.json
  Cache-Control: no-cache

/gorcave-version.json
  Cache-Control: no-cache
