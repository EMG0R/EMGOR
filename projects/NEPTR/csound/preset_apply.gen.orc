; edge scan: feeds the activation-order ring (PresetSeqPush/Drop in preset_seq.orc).
; kMode 0 = follow edges, 1 = resync (prev := now, no push), 2 = rebuild ring
; from the current state in id order, VOLUME last.
opcode PresetScan, 0, k
  kMode xin
  if (kMode == 2) then
    PresetSeqClear
  endif
  kOn = (gkATTK_bypass < 0.5) ? 1 : 0
  if (kOn != tab:k(2, giSeqPrev)) then
