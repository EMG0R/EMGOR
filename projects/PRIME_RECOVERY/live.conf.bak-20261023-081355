# DEMIURGE-DEVICES-BEGIN
# devices detected by DEMIURGE (read-only, auto-refreshed when idle)
# audio:
#   - Built-in Audio Pro  (in + out)
# midi:
#   - Teensy MIDI
#   - NEPTR Serial Bridge
#   - Csound
#   - Csound
#   - PipeWire-System
#   - PipeWire-RT-Event
# DEMIURGE-DEVICES-END
# ~/demiurge/live.conf -- the one user-facing DEMIURGE config.
# Generic starter written by setup-demiurge.sh. Edit freely; the installer never
# overwrites this file. Unknown keys are ignored; '#' starts a comment.

# ---------- globals ----------
link    = off
bpm     = 124
rate    = 48000
quantum = 512

# ---------- sync layer ----------
# on  = the chain runs as PipeWire stages wired into demiurge-sink
# off = the first program in the chain talks to the interface directly (bypass)
sync_layer = on

# ---------- rnbo ----------
rnbo = off

# ---------- touch ----------
touch = off

# ---------- audio device (bypass: csound owns the card directly) ----------
audio_interface = hw:CARD=sndrpihifiberry,DEV=0

# ---------- NEPTR UI (neptr-ui.service -> demiurge-ui-launch.sh) ----------
ui      = on
ui_cmd  = $HOME/kivy-venv/bin/python $HOME/NEPTR_phase4/neptrPhase4_UI.py
power   = high

ui_also =

# ---------- chain ----------
# One program per indented line (absolute path or ~/...). Language is taken from
# the file extension (.csd .ck .pd .scd .dsp .strudel .cpp .rnbo).
chain =
  ~/NEPTR_phase4/csound/neptrPhase4.csd

# ---------- csound ----------
# JACK ring between csound engine thread and the graph callback. Q*2 (128) xrun-stormed
# continuously on the 8ch NEPTR rig (2026-10-22); 512 = +8 ms.
# csound_host = embedded: csound runs inside the JACK callback (no engine->graph ring, clocked by the graph).
csound_host = embedded
# csound_extra = --hardwarebufsamps=512   # only for csound_host = standalone
