[Unit]
Description=hyperTrumpet supervisor (relaunch loop for the hyperTrumpet Bela project)
After=network.target sound.target
# bela_startup.service must stay DISABLED: it fights this loop for the audio
# device and produces 1/s crash storms (hyperGuitar 2026-11-01 incident).
Conflicts=bela_startup.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/hypertrumpet
ExecStart=/root/hyperTrumpet-supervisor.sh
Restart=always
RestartSec=2
WorkingDirectory=/root/Bela/projects/hyperTrumpet

[Install]
WantedBy=multi-user.target
