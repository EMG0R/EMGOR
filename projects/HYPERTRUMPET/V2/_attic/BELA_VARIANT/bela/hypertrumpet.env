# /etc/default/hypertrumpet  - sourced by the gadget script, the supervisor and
# the bridge unit. Plain VAR=value (sh syntax). install.sh creates it once and
# never overwrites an edited copy. Gadget values apply at next BOOT.
HT_PROJECT=hyperTrumpet
# Bela audio block size passed as -p. 64 is the value hyperGuitar proved stable
# for a heavy DSP chain on this PocketBeagle 2 / Gem image; UNMEASURED for the
# trumpet. Try 32 only after counting "Underrun detected" in the log.
HT_BLOCK=64
# USB audio. The Bela project's sample rate MUST equal this (ring is not resampled).
HT_USB_RATE=44100
# 15 = 4 ch to host (1-2 FX out, 3-4 dry bell mic / contact mic). 3 = FX only.
HT_UAC2_P_CHMASK=15
HT_UAC2_C_CHMASK=3
# USB product string; macOS shows this as the device name.
HT_USB_PRODUCT=hyperTrumpet
