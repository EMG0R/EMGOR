	<!-- CFPlugIn factory registration: tells CFPlugIn what factory function
	     to call for the kAudioServerPlugInTypeUUID plug-in type, and which
	     UUID that factory returns interfaces for (kAudioServerPlugInTypeUUID
	     again, since this bundle only implements one plug-in type). -->
	<key>CFPlugInFactories</key>
	<dict>
		<key>443ABAB8-E7B3-491A-B985-BEB9187030DB</key>
		<string>OmniplexAudio_Create</string>
	</dict>
	<key>CFPlugInTypes</key>
	<dict>
		<key>443ABAB8-E7B3-491A-B985-BEB9187030DB</key>
		<array>
			<string>443ABAB8-E7B3-491A-B985-BEB9187030DB</string>
		</array>
	</dict>

	<!-- This plugin uses POSIX shared memory (shm_open) to talk to the
	     omniplex-cli Rust process. Declaring network=true is not strictly
	     required for POSIX shm, but is included defensively in case
	     coreaudiod's sandbox profile treats local IPC primitives under the
	     same restriction; harmless if unnecessary. -->
	<key>AudioServerPlugIn_Network</key>
	<true/>
</dict>
</plist>
