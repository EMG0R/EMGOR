#N canvas 0 0 640 420 10;
#X obj 20 20 loadbang;
#X obj 20 50 f \$1;
#X obj 20 80 sel 0;
#X msg 20 110 listen \$1;
#X obj 20 140 netreceive -u -b;
#X obj 20 170 oscparse;
#X obj 20 200 list trim;
#X obj 20 230 route p;
#X obj 20 260 s demiurge-param-rx;
#X obj 200 20 r demiurge-param-port;
#X obj 340 20 loadbang;
#X obj 340 50 f \$2;
#X obj 340 80 sel 0;
#X obj 340 110 del 1000;
#X msg 400 140 connect 127.0.0.1 \$1;
#X obj 480 20 r demiurge-pool-port;
#X obj 400 200 r demiurge-param-tx;
#X obj 400 230 netsend -u -b;
#X obj 400 170 t a b;
#X msg 520 200 disconnect;
#X msg 340 140 9102;
#X msg 480 50 stop;
#X text 20 300 [dparam_rx port poolport] - ONE per patch. 0 = take it from "demiurge-param-port N" / "demiurge-pool-port N" (pd -send). poolport default 9102, used only if no "demiurge-pool-port" message arrives within 1 s.;
