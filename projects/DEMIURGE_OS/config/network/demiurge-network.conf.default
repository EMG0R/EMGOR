# DEMIURGE — network guard config
# Install to: /etc/demiurge/network.conf
#
# Sourced by /usr/local/bin/demiurge-netguard.sh. Shell syntax, root-owned.
# Every key is optional; the script carries the same defaults inline.

# The network this box belongs to. When set, the guard steers wifi back to
# this SSID if it ever associates with something else while this one is in
# range — the single fix for "the Pi joined the neighbour's AP and vanished".
# Leave empty to disable SSID enforcement entirely.
HOME_SSID="GOR_CAVE"
ENFORCE_HOME_SSID=1

# ONE LINK AT A TIME. Wired and wireless are on the same subnet here, so with
# both up the box holds two addresses and avahi advertises both — and a Mac
# resolving `demiurge.local` is free to pick the wifi one even though the
# route metrics prefer the cable. That is how every tool ended up talking to
# the Pi over the flaky link. With ETH_EXCLUSIVE=1 the guard parks wifi
# whenever ethernet's gateway actually answers, so there is exactly one
# address and no ambiguity. Set to 0 to keep both links up instead.
ETH_EXCLUSIVE=1

# Interfaces. The wired device is never bounced or disconnected by the guard.
ETH_IF="eth0"
WIFI_IF="wlan0"

# Recovery ladder, counted in consecutive failed gateway pings (20s apart).
PING_TIMEOUT=2
BOUNCE_AFTER=2         # ~40s of no gateway  -> disconnect/connect wlan0
RADIO_CYCLE_AFTER=6    # ~2min of no gateway -> wifi radio off/on
