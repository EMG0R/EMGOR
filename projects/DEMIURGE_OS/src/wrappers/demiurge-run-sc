#!/bin/bash
# demiurge-run-sc <file.scd> [extra sclang args...]
# Launches SuperCollider sclang with headless Qt. QT_QPA_PLATFORM is
# already offscreen via demiurge-env.sh so sclang boots without a
# display. scsynth is spawned by sclang and inherits the env.
set -e
source /opt/demiurge/lib/demiurge-env.sh 2>/dev/null || source "$(dirname "$0")/../lib/demiurge-env.sh"

if [[ -z "$1" ]]; then
    echo "usage: demiurge-run-sc <file.scd> [extra args...]" >&2
    exit 1
fi

FILE="$1"; shift
exec sclang "$FILE" "$@"
