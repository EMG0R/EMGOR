#!/bin/bash
# demiurge-patch-new <name> — create a new patch FOLDER with a blank phone UI.
#
#   INSTALL ON THE PI:  sudo install -m0755 demiurge-patch-new /usr/local/bin/demiurge-patch-new
#
# Creates  <PATCH_ROOT>/<name>/
#            <name>.conf       engine config, seeded from the active live.conf
#                              with its `# set:` header re-tagged to <name>
#                              (SEED=none for a header-only stub)
#            <name>.map.json   empty pool mapping store (docs/parameters.md s5)
#            index.html        blank phone UI; title derived from the folder name
#            state/            saved UI/param snapshots (empty)
#
# It does NOT activate the patch. Activation stays demiurge-patch / demiurge-set
# (copy conf over live.conf, `# set:` header = active patch). See docs/patch-folders.md.
#
# Idempotent + non-destructive: every file is created only if missing, written
# via tmp+mv; an existing patch (folder OR flat <name>.conf) is never modified.
# DRY_RUN=1 prints what would happen and touches nothing.
#
# Env: PATCH_ROOT (default ~/demiurge/patches), LIVE (default ~/demiurge/live.conf),
#      SEED=live|none, DRY_RUN=1
set -euo pipefail

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: demiurge-patch-new <name>" >&2; exit 1; }
# Letters, digits, _ and -; must start alphanumeric. Same charset the web layer
# can safely put in a URL path and a shell argv.
if ! [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; then
    echo "demiurge-patch-new: bad name '$NAME' (use A-Z a-z 0-9 _ -, max 64, start alphanumeric)" >&2
    exit 1
fi

ROOT="${PATCH_ROOT:-$HOME/demiurge/patches}"
LIVE="${LIVE:-$HOME/demiurge/live.conf}"
SEED="${SEED:-live}"
DRY="${DRY_RUN:-0}"
DIR="$ROOT/$NAME"

say() { if [ "$DRY" = 1 ]; then echo "[dry-run] $*"; else echo "[demiurge-patch-new] $*"; fi; }

# Never shadow an existing patch in either layout.
if [ -f "$ROOT/$NAME.conf" ] && [ ! -d "$DIR" ]; then
    echo "demiurge-patch-new: flat patch '$NAME' already exists ($ROOT/$NAME.conf)." >&2
    echo "  Migrate it by hand (mkdir + cp, additive): see docs/patch-folders.md." >&2
    exit 2
fi

# Human title from the folder name: underscores/dashes -> spaces.
TITLE="${NAME//[_-]/ }"

# Run a write step honouring DRY_RUN. $1 = destination, content on stdin.
# Created only when missing; atomic tmp+mv.
put() {
    local dest="$1" tmp
    if [ -e "$dest" ]; then
        cat >/dev/null
        say "keep   $dest (exists)"
        return 0
    fi
    if [ "$DRY" = 1 ]; then
        cat >/dev/null
        say "create $dest"
        return 0
    fi
    tmp="$dest.tmp.$$"
    cat >"$tmp"
    mv -n "$tmp" "$dest"
    [ -e "$tmp" ] && rm -f "$tmp"
    say "created $dest"
}

if [ -d "$DIR" ]; then say "folder exists, filling only missing files: $DIR"
elif [ "$DRY" = 1 ]; then say "mkdir $DIR"
else mkdir -p "$DIR"; say "mkdir $DIR"; fi

# ---- <name>.conf ----------------------------------------------------------
conf_body() {
    if [ "$SEED" = live ] && [ -f "$LIVE" ]; then
        # Re-tag: drop any existing set/patch header, put ours first.
        printf '# set: %s\n' "$NAME"
        grep -v -E '^#[[:space:]]*(set|patch):' "$LIVE" || true
    else
        printf '# set: %s\n# power: high\n# Blank patch. Add chain = ... lines (see live.conf for the format).\n' "$NAME"
    fi
}
conf_body | put "$DIR/$NAME.conf"

# ---- <name>.map.json (docs/parameters.md s5 schema, empty) ----------------
cat <<JSON | put "$DIR/$NAME.map.json"
{ "version": 1, "patch": "$NAME", "maps": [], "values": {} }
JSON

# ---- index.html: blank phone UI, name from the folder ---------------------
# $NAME is validated to [A-Za-z0-9_-] so it is safe to inline in HTML/JS.
cat <<HTML | put "$DIR/index.html"
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>$TITLE</title>
<!-- Auto-generated by demiurge-patch-new. Safe to replace wholesale; it is
     never regenerated once it exists. Served at /patch/$NAME/ .
     Contract: talk to the pool only via /api/pool/* (GET params, POST set).
     Patch name is available as document.body.dataset.patch. -->
<style>
  :root { --bg:#0d0a14; --fg:#e8def8; --accent:#9b6dff; }
  html,body { margin:0; height:100%; background:var(--bg); color:var(--fg);
              font:16px/1.4 system-ui,sans-serif; }
  main { padding:16px; }
  h1 { margin:0 0 12px; font-size:1.25rem; color:var(--accent); font-weight:600; }
</style>
</head>
<body data-patch="$NAME">
<main>
  <h1>$TITLE</h1>
  <!-- controls go here -->
</main>
</body>
</html>
HTML

# ---- state/ ---------------------------------------------------------------
if [ -d "$DIR/state" ]; then say "keep   $DIR/state (exists)"
elif [ "$DRY" = 1 ]; then say "mkdir $DIR/state"
else mkdir -p "$DIR/state"; say "mkdir $DIR/state"; fi

say "done: $NAME (not activated; activate with demiurge-patch $NAME)"
