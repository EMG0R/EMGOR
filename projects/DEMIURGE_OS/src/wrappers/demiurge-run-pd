#!/bin/bash
# demiurge-run-pd <file.pd> [extra pd args...]
# Launches Pure Data headless with JACK and ALSA-seq MIDI. Patches MUST
# include `[loadbang] → [; pd dsp 1(` or they produce zero samples
# under -nogui. See docs/gotchas.md Q8.
set -e
source /opt/demiurge/lib/demiurge-env.sh 2>/dev/null || source "$(dirname "$0")/../lib/demiurge-env.sh"

if [[ -z "$1" ]]; then
    echo "usage: demiurge-run-pd <file.pd> [extra args...]" >&2
    exit 1
fi

FILE="$1"; shift
exec pd -nogui -jack -alsamidi -r 48000 -blocksize 64 -audiobuf 5 "$FILE" "$@"
