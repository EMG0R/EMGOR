#N canvas 60 60 900 780 10;
#X text 20 8 hello nonlinear daylight - DEMIURGE Pd example. 3 params 0..1 via the pool hook (UDP 9000): /nld-pd/density /nld-pd/tone /nld-pd/length \; vanilla objects only.;
#X obj 20 60 loadbang;
#X msg 20 85 \; pd dsp 1;
#X msg 100 85 0.3;
#X msg 150 85 0.5;
#X msg 200 85 0.5;
#X obj 100 110 s nld_density;
#X obj 150 110 s nld_tone;
#X obj 200 110 s nld_length;
#X msg 260 110 1;
#X obj 260 85 del 200;
#X text 330 40 --- OSC in (pool -> stage) ---;
#X obj 330 60 dparam_rx 0 0;
#X obj 330 110 dparam /nld-pd/density 0.3;
#X obj 440 110 dparam /nld-pd/tone 0.5;
#X obj 550 110 dparam /nld-pd/length 0.5;
#X obj 330 160 dpout /nld-pd/density;
#X obj 440 160 dpout /nld-pd/tone;
#X obj 550 160 dpout /nld-pd/length;
#X obj 330 215 s nld_density;
#X obj 440 215 s nld_tone;
#X obj 550 215 s nld_length;
#X text 330 240 pool in and out via the params/pd abstractions;
#X obj 20 170 r nld_density;
