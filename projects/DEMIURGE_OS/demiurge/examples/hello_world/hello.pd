#N canvas 60 60 900 640 10;
#X text 20 10 DEMIURGE Pd hello_world — generative pentatonic arp \,
tempo-locked to demiurge-clock via ch16 CC119. Shared bus MIDI note/CC.;
#X text 20 28 Launch: pd -nogui -jack -jackname pd_hello -alsamidi
-midiindev 1 -midioutdev 1 -send 'pd dsp 1' hello.pd;
#X text 20 46 JACK ports: output_1/output_2 (out) \, input_1/input_2
(in). ALSA seq client name: "Pure Data" ports "Pure Data Midi-In 1"
/ "Pure Data Midi-Out 1".;
#X obj 20 80 loadbang;
#X msg 20 105 \; pd dsp 1;
#X obj 20 140 r bpm;
#X obj 20 165 / 4;
#X obj 20 190 t f f;
#X obj 20 215 60000;
#X obj 20 240 / $1;
#X obj 20 265 metro 125;
#X obj 20 290 random 5;
#X obj 20 315 tabread pent;
#X obj 20 340 + 48;
#X obj 20 365 mtof;
#X obj 20 390 osc~;
#X obj 20 420 r vol;
#X obj 20 445 pack f 30;
#X obj 20 470 line~;
#X obj 20 495 *~;
#X obj 20 520 lop~ 2400;
#X obj 20 545 dac~ 1 2;
#X text 260 80 --- shared MIDI bus ---;
#X obj 260 105 notein;
#X obj 260 130 mtof;
#X obj 260 155 osc~ 440;
#X obj 260 180 *~ 0.25;
#X obj 260 205 line~;
#X obj 320 205 pack f 120;
#X obj 320 180 t b b;
#X obj 320 155 sel 0;
#X msg 380 205 1 10;
#X msg 320 230 0 80;
#X obj 500 80 ctlin;
#X obj 500 105 route 1 7 119;
#X obj 500 135 / 127;
#X obj 500 160 s morph;
#X obj 580 135 / 127;
#X obj 580 160 s vol_raw;
#X obj 660 135 t f f;
#X obj 660 160 * 200;
#X obj 660 185 + 40;
#X obj 660 210 s bpm;
#X obj 660 235 print BPM;
#X text 780 80 CC router: 1=morph \, 7=vol \, 119=BPM (ch16).;
#X text 780 100 ctlin with no args accepts all channels \; we route by
controller number — ch16 CC119 is the clock broadcast and always wins.;
#X obj 20 600 r vol_raw;
#X obj 20 625 pack f 120;
#X obj 90 600 s vol;
#X obj 620 80 array pent 5 float 0;
#X text 620 60 Pentatonic scale (0 3 5 7 10):;
#A pent 0 3 5 7 10;
#X connect 3 0 4 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 9 1;
#X connect 8 0 9 0;
#X connect 9 0 10 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 19 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 18 0 19 1;
#X connect 19 0 20 0;
#X connect 20 0 21 0;
#X connect 20 0 21 1;
#X connect 23 0 24 0;
#X connect 24 0 25 0;
#X connect 25 0 26 0;
#X connect 26 0 21 0;
#X connect 26 0 21 1;
