#N canvas 60 60 920 640 10;
#X obj 20 30 loadbang;
#X msg 20 60 \; pd dsp 1;
#X obj 20 110 adc~ 1 2;
#X obj 20 160 delwrite~ vl 20;
#X obj 180 160 delwrite~ vr 20;
#X obj 20 240 vd~ vl;
#X obj 180 240 vd~ vr;
#X obj 20 310 dac~ 1 2;
#X obj 380 180 osc~ 5;
#X obj 380 210 *~ 1.4;
#X obj 380 240 +~ 5;
#X obj 540 30 netreceive 9997 1;
#X obj 540 60 route bpm transport;
#X obj 540 90 expr 240000 / $f1;
#X obj 540 160 metro 546;
#X obj 540 190 random 3;
#X obj 540 220 + 2;
#X text 20 360 DEMIURGE hello_patching — stage 2: Pd VIBRATO + BEAT STEP.;
#X text 20 378 Vibrato rate re-chosen every beat from the global clock.;
#X text 20 396 BPM arrives over UDP 9997 via pd_clock_bridge.py (the bridge;
#X text 20 414 reads ch16 CC119 from the shared MIDI pool and forwards as FUDI).;
#X obj 640 280 dparam_rx 0 0;
#X obj 640 320 dparam /pd/vibrato 0.4;
#X obj 640 360 * 3.5;
#X obj 760 360 dpout /pd/vibrato;
#X text 640 240 PARAMETER /pd/vibrato (0..1 = depth 0..3.5 ms);
#X text 640 256 Pool in/out via params/pd/ abstractions (pd -path);
#X text 640 272 stage 2 -> port 9002 via pd -send from the launcher (params/pd.json);
#X connect 0 0 1 0;
#X connect 0 0 14 0;
#X connect 2 0 3 0;
