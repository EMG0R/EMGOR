#define STATE_PERSIST ##
#include "/Users/emgor/Documents/_EMGOR_SYNTH/______2026NEW/NEPTR phase4/csound/state_persist.orc"

instr 900
    ; Report the observable: a restore turns bypass 0 (active), a decline
    ; leaves the init value of 1 (bypassed). ATTK is index 2 in the layout.
    kd init 0
    if (kd == 0) then
        kd = 1
        printf "RESULT loaded=%d attk_bypass=%.0f cfb_bypass=%.0f\n", 1, \
               gkNeptrStLoaded, gkATTK_bypass, gkCFB_bypass
    endif
endin
