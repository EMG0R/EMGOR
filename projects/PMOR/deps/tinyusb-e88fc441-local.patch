   (void)itf;
 }
 
+// Pocket OpGorator instrumentation hook (2026-08-11, not upstream TinyUSB):
+// fires once per successful TX endpoint transfer completion, with the
+// literal byte count the hardware actually put on the wire. This is a
+// ground-truth counter -- unlike counting at the call site of
+// tud_midi_stream_write()/tud_midi_packet_write() (which only proves the
+// application asked TinyUSB to send something), this proves data actually
+// left the USB core. See clock_engine.c's "diag" CDC command / README
+// "measured tick-rate bug" for why a ground-truth TX counter was needed:
+// hardware measurement showed the host receiving ~2.3% MORE MIDI Clock
+// bytes than the firmware's own emission-call-site counter recorded, and
+// this hook is what would prove or disprove TinyUSB's TX path itself as
+// the source of that gap (vs. e.g. a host-side or CIN-framing issue).
+TU_ATTR_WEAK void tud_midi_tx_complete_cb(uint8_t itf, uint32_t xferred_bytes) {
+  (void)itf;
+  (void)xferred_bytes;
+}
