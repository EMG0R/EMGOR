[Unit]
Description=NO MANS GOR multiplayer relay (WebSocket fan-out, no persistence)
After=network.target

[Service]
User=server
WorkingDirectory=/home/server/nmg-relay
ExecStart=/usr/bin/node server.js
Environment=PORT=8797
Environment=NODE_ENV=production
Environment=HOME=/home/server
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=2
Nice=10
CPUQuota=150%
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/server
PrivateTmp=true

[Install]
WantedBy=multi-user.target
