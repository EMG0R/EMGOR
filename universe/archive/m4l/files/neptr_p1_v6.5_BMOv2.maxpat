, 																												{
																													"box" : 																													{
																														"maxclass" : "newobj",
																														"text" : "in 4 @min 0.1 @default 100. @comment decay",
																														"patching_rect" : [ 600.67999267578125, 56.0, 263.0, 22.0 ],
																														"outlettype" : [ "" ],
																														"numinlets" : 0,
