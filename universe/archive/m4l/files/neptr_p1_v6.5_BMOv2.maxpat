, 																												{
																													"box" : 																													{
																														"maxclass" : "newobj",
																														"text" : "in 6 @min 0.1 @default 150. @comment release",
																														"patching_rect" : [ 985.79998779296875, 56.0, 271.0, 22.0 ],
																														"outlettype" : [ "" ],
																														"numinlets" : 0,
																														"id" : "obj-9",
																														"numoutlets" : 1
																													}

																												}
, 																												{
																													"box" : 																													{
																														"maxclass" : "newobj",
																														"text" : "in 5 @min 0. @max 1. @default 0.5 @comment sustain",
																														"patching_rect" : [ 793.239990234375, 24.0, 307.0, 22.0 ],
																														"outlettype" : [ "" ],
																														"numinlets" : 0,
